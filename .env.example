# Copy this file to .env and change the values if you need to.
# No API key is needed. The model runs locally with Ollama.

# Which Ollama model to use
OLLAMA_MODEL=llama3.2:3b

# Where Ollama is running
# On your Mac: http://localhost:11434/v1
# Inside Docker: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
